#!/bin/sh

# sudo systemctl list-units --full -all -t service --no-legend | grep -q 'klipper.service'
# K1 compatibility layer for systemctl
if [ "$1" = "reboot" ]; then
  /sbin/reboot
elif [ "$1" = "poweroff" ]; then
  /sbin/poweroff
elif [ "$1" = "restart" ] || [ "$1" = "stop" ] || [ "$1" = "start" ]; then
  if [ "$2" = "klipper" ]; then
    if [ -f /etc/init.d/S55klipper_service ]; then
        /etc/init.d/S55klipper_service $1
    fi
  elif [ "$2" = "klipper_mcu" ]; then
    if [ -f /etc/init.d/S57klipper_mcu ]; then
        /etc/init.d/S57klipper_mcu $1 2> /dev/null
    fi
  elif [ "$2" = "moonraker" ]; then
    if [ -f /etc/init.d/S56moonraker_service ]; then
        /etc/init.d/S56moonraker_service $1
    fi
  elif [ "$2" = "webcam" ]; then
    if [ -f /etc/init.d/S50webcam ]; then
        /etc/init.d/S50webcam $1
    fi
  elif [ "$2" = "nginx" ]; then
    if [ -f /etc/init.d/S50nginx_service ]; then
        /etc/init.d/S50nginx_service $1
    fi
  elif [ "$2" = "grumpyscreen" ]; then
    if [ -f /etc/init.d/S99grumpyscreen ]; then
        /etc/init.d/S99grumpyscreen $1
    fi
  fi
elif [ "$1" = "list-units" ]; then
  # Moonraker uses this to discover the services it may manage.  Creality OS
  # uses init scripts rather than systemd, so expose its service list in the
  # subset of systemctl's output format that Moonraker needs.
  services_file=/usr/data/printer_data/moonraker.asvc
  if [ -f "$services_file" ]; then
    while IFS= read -r service; do
      [ -n "$service" ] || continue
      printf '  %-36s loaded    active   running %s\n' "$service.service" "${service}.service"
    done < "$services_file"
  fi
fi
