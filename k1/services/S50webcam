#!/bin/sh

PID_FILE="/var/run/webcam.pid"

CONFIG_FILE=/usr/data/printer_data/config/webcam.ini
CONFIG_HELPER=/usr/data/pellcorp/tools/config-helper.py

# max fps for the camera
FRAMES_PER_SECOND=10
WORKERS=1
BUFFERS=1
RESOLUTION="1280x720"

# prints the value of a key in webcam.ini, or the default ($2) if the key is missing or blank
ini_value() {
  value=$(grep "^$1[[:space:]]*=" "$CONFIG_FILE" | head -n 1 | cut -d '=' -f 2- | tr -d '[:space:]')
  if [ -n "$value" ]; then
    echo "$value"
  else
    echo "$2"
  fi
}

start() {
  # allow configuration via a webcam.ini file
  if [ -f "$CONFIG_FILE" ]; then
    FRAMES_PER_SECOND=$(ini_value frames_per_second "$FRAMES_PER_SECOND")
    WORKERS=$(ini_value workers "$WORKERS")
    BUFFERS=$(ini_value buffers "$BUFFERS")
    RESOLUTION=$(ini_value resolution "$RESOLUTION")
    FLIP_VERTICAL=$(ini_value flip_vertical "false")
    DISABLE_NEBULA_IRLIGHT=$(ini_value disable_nebula_irlight "false")
  fi

  V4L_DEVICE=$(v4l2-ctl --list-devices|grep -A1 usb|sed 's/^[[:space:]]*//g'|grep '^/dev' | head -1)
  if [ "x$V4L_DEVICE" = "x" ]; then
    echo "WARNING: No webcams found!"
    exit 1
  fi

  if [ "$DISABLE_NEBULA_IRLIGHT" = "true" ]; then
    /usr/data/pellcorp/k1/tools/cam_util.py off "$V4L_DEVICE" > /dev/null
  fi

  # re-apply camera controls from the webcam.ini [controls] section, one at a time so a rejected
  # control does not stop the rest, auto controls first so manual values that depend on them are accepted
  if [ -f "$CONFIG_FILE" ]; then
    controls=$($CONFIG_HELPER --file "$CONFIG_FILE" --section-entries controls 2> /dev/null | tr -d ' \t' | tr '\n' ' ')
    for pass in auto manual; do
      for control in $controls; do
        case "${control%%=*}" in
          *auto*) [ "$pass" = "auto" ] || continue ;;
          *) [ "$pass" = "manual" ] || continue ;;
        esac
        if [ -n "${control#*=}" ]; then
          v4l2-ctl -d "$V4L_DEVICE" --set-ctrl "$control" > /dev/null 2>&1
        fi
      done
    done
  fi

  flip_vertical_arg=""
  if [ "$FLIP_VERTICAL" = "true" ]; then
    flip_vertical_arg="--flip-vertical=1"
  fi
  start-stop-daemon -S -b -m -p "$PID_FILE" --exec /usr/data/ustreamer/ustreamer -- -n -r "$RESOLUTION" -c HW -m MJPEG -b "$BUFFERS" -w "$WORKERS" -f "$FRAMES_PER_SECOND" -l -d "$V4L_DEVICE" --host=0.0.0.0 '--allow-origin=*' --device-timeout 15 $flip_vertical_arg
}

stop() {
  start-stop-daemon -K -p $PID_FILE > /dev/null 2>&1

  # actually wait for the service to stop
  service_pid="$(cat $PID_FILE 2> /dev/null)"
  if [ -n "$service_pid" ]; then
    # wait up to 30 seconds for a graceful stop, then kill -9
    wait_count=0
    while [ -d "/proc/$service_pid" ] && [ "$wait_count" -lt 150 ]; do
      sleep 0.2
      wait_count=$((wait_count + 1))
    done
    if [ -d "/proc/$service_pid" ]; then
      kill -9 "$service_pid" 2> /dev/null
    fi
    rm -f $PID_FILE
  fi
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;

  restart|reload)
    stop
    start
    ;;
  *)
    echo "Usage:"
    echo "    $0 {start|stop|restart}"
    exit 1
esac

exit $?
