#!/bin/sh

RC_DIR=/run/openrc
SUPERVISE_DAEMON=/usr/data/pellcorp/k1/files/respawn/supervise-daemon
GUPPYSCREEN=/usr/data/grumpyscreen/grumpyscreen
GUPPYSCREEN_LOG=/usr/data/printer_data/logs/grumpyscreen.log
PID_FILE="/var/run/guppyscreen.pid"
SVC_NAME=guppyscreen
CONFIG_HELPER=/usr/data/pellcorp/tools/config-helper.py

# FIXME - ideally maybe we should change grumpyscreen to nicely handle error code from switch to stock so we dont need to disable the button
# for now for the few people using retail Nebula Pad this will do
MODEL=$(/usr/bin/get_sn_mac.sh model)
if [ "$MODEL" = "Nebula Pad" ] && grep -q '^switch_to_stock_cmd:[[:space:]]*[^[:space:]]' /usr/data/grumpyscreen/grumpyscreen.cfg; then
  sed -i "s/switch_to_stock_cmd:.*/switch_to_stock_cmd:/g" /usr/data/grumpyscreen/grumpyscreen.cfg
fi

start_server() {
    # kill the boot display so it does not keep showing over top of grumpyscreen
    killall boot_display 2> /dev/null
    # display black transition image to stop the corrupt image being shown
    cmd_jpeg_display /usr/data/pellcorp/k1/black.jpg &

    # if spoolman is configured we should show the left nav otherwise don't
    HIDE_SPOOLMAN=true
    if $CONFIG_HELPER --file moonraker.conf --include-exists "spoolman.conf"; then
      HIDE_SPOOLMAN=false
    fi

    HIDE_MMU=true
    if $CONFIG_HELPER --file moonraker.conf --section-exists "update_manager afc-software"; then
      HIDE_MMU=false
    fi
    if $CONFIG_HELPER --file moonraker.conf --section-exists "update_manager happy-hare"; then
      HIDE_MMU=false
    fi

    export HOME=/root
    sync && echo 3 > /proc/sys/vm/drop_caches
    mkdir -p $RC_DIR
    RC_SVCNAME=guppyscreen $SUPERVISE_DAEMON guppyscreen -e "HIDE_SPOOLMAN=$HIDE_SPOOLMAN" -e "HIDE_MMU=$HIDE_MMU" -e "INVERT_Z_ICON=false" -e "DISPLAY_ROTATE=0" -e "CONFIG_OVERRIDE_FILE=/usr/data/printer_data/config/grumpyscreen.ini" -e "CONFIG_VENDOR_FILE=/usr/data/grumpyscreen/macros.cfg" -e "CONFIG_FILE=/usr/data/grumpyscreen/grumpyscreen.cfg" -e "WPA_SUPPLICANT_SOCKET=/var/run/wpa_supplicant" --start --stdout $GUPPYSCREEN_LOG --stderr $GUPPYSCREEN_LOG --pidfile $PID_FILE $GUPPYSCREEN
}

stop_server() {
    local service_pid="$(cat $PID_FILE 2> /dev/null)"
    local is_running=false
    if [ -n "$service_pid" ] && [ -d /proc/"$service_pid" ]; then
      is_running=true
    fi
    RC_SVCNAME=guppyscreen $SUPERVISE_DAEMON guppyscreen --stop --pidfile $PID_FILE > /dev/null 2>&1

    if [ "$is_running" = "true" ]; then
        # after stopping grumpyscreen, clear the screen with this afterwards to avoid showing a corrupted image
        cmd_jpeg_display /usr/data/pellcorp/k1/black.jpg &
    fi
}

case "$1" in
    start)
        start_server
        ;;
    stop)
        stop_server
        ;;
    restart|reload)
        stop_server
        # this allows a graceful restart of service by actually waiting for it to stop first
        service_pid="$(cat $PID_FILE 2> /dev/null)"
        if [ -n "$service_pid" ]; then
            while true; do
                    if [ ! -d /proc/"$service_pid" ] ; then
                        break
                    fi
            done
        fi
        start_server
        ;;
    *)
        echo "Usage:"
        echo "    $0 {start|stop|restart}"
        exit 1
esac

exit $?
