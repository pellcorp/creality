# Default CR10SE

-- bltouch.cfg
[bltouch]
sensor_pin: nozzle_mcu: PA9
control_pin: nozzle_mcu: PA10
x_offset: -27.0
y_offset: 0.69
speed: 10

[bed_mesh]
speed: 350
mesh_min: 5,5
mesh_max: 215,215
probe_count: 5,5
horizontal_move_z: 8

[screws_tilt_adjust]
__action__: DELETED

[axis_twist_compensation]
calibrate_start_x: 30
calibrate_end_x: 192
calibrate_y: 105
