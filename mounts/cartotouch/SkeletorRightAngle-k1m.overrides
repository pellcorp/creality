-- cartotouch.cfg
[scanner]
x_offset: -24.0
y_offset: 0.0

[bed_mesh]
mesh_min: 10,10
mesh_max: 275,290

[screws_tilt_adjust]
__action__: DELETED

[axis_twist_compensation]
mesh_min: 10,10
mesh_max: 275,290

-- printer.cfg
[stepper_y]
position_max: 306
